# Kopieer naar .env en vul in. Zonder MOLLIE_API_KEY draait de site in testmodus
# (alleen buiten productie): dan kun je een nepbetaling doen om de flow te proberen.

PORT=3000
BASE_URL=https://www.dejongendiekerstmist.nl
NODE_ENV=production

# Verhaal
START_DATUM=2026-12-01
GRATIS_BRIEVEN=3
PRIJS=9.95

# Betalen via Mollie (iDEAL, creditcard, Apple Pay). Begin met een test_ sleutel.
MOLLIE_API_KEY=

# Geheime sleutel waarmee Nadia alles vooraf kan lezen:
# open https://www.dejongendiekerstmist.nl/voorvertoning?sleutel=<PREVIEW_KEY>
PREVIEW_KEY=

# Optioneel: koper krijgt de sleutel ook per e-mail (via Resend)
RESEND_API_KEY=
MAIL_VAN=De Jongen die Kerst Mist <post@dejongendiekerstmist.nl>

# Alleen om te testen: doe alsof het vandaag deze datum is
# FAKE_VANDAAG=2026-12-05
